rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Shared helpers ------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    // Caller owns the EXISTING doc (read/update/delete).
    function ownsExisting() {
      return signedIn() && request.auth.uid == resource.data.userId;
    }
    // Caller owns the INCOMING doc (create/update) — also enforces that the
    // userId being written equals the caller, so owners can't reassign a doc
    // to another user on update.
    function ownsIncoming() {
      return signedIn() && request.auth.uid == request.resource.data.userId;
    }
    // Single source of truth for admin. Mirrors ADMIN_UIDS in
    // src/constants/admins.js and also honors /admins/{uid} docs.
    function isAdmin() {
      return signedIn() && (
        request.auth.uid in ['b0eUycwZDHcmrkoeSEiD69QSbK32', 'A0yRGP86ZTahByzS0ALYeKAXOn52'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Pre-generated MCQ bank, shared by every student.
    //
    // Read-only for clients, deliberately. A client that could write here could
    // put a wrong answer key in front of the whole user base, and no shape rule
    // can validate that an answer is correct. Seeding runs from
    // scripts/seed-question-bank.mjs with service-account credentials.
    match /questionBank/{bundleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /questionBankIndex/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shared curriculum content (lessons, practice, unit summaries).
    // World-readable (no PII); written only by admins via the Learn UI.
    match /curriculum/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User documents - only accessible by the owner (path-scoped, so userId is
    // taken from the path and cannot be spoofed via document data).
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      // User's test history
      match /testHistory/{testId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // User's flashcards
      match /flashcards/{flashcardId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // User's progress data
      match /progress/{progressId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // Pointers to the classes this user has joined. Keeps "my classes" a
      // user-scoped read instead of a collection-group query across /classes.
      match /classes/{classId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // User's curriculum progress (completed topics + practice scores)
      match /curriculumProgress/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // User's AI usage counters.
      //   usage/ai       — client-written soft cap (UX display + client limit).
      //   usage/aiServer — written ONLY by the ai-proxy function (admin SDK);
      //                    clients can read it but never write it, so the
      //                    server-enforced quota is tamper-proof (Codex P1-1).
      match /usage/{docId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn() && request.auth.uid == userId && docId != 'aiServer';
      }

      // Server-only secrets (Schoology OAuth tokens, etc.). Written/read ONLY by
      // the Netlify functions via the admin SDK (which bypasses rules). Clients
      // are fully denied so tokens can never reach the browser (Codex P1-4).
      match /private/{docId} {
        allow read, write: if false;
      }

      // User's Schoology tokens - extra sensitive
      match /schoologyTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // User's settings and preferences
      match /settings/{settingId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // User's scheduler tasks
      match /tasks/{taskId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // User's scheduler preferences
      match /schedulerPreferences/{prefId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // User's third-party integrations (Schoology, etc.)
      match /integrations/{integrationId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // User's sync history (Schoology assignment sync tracking)
      match /syncHistory/{syncId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // Conversations at root level - accessible by owner.
    // Split create/update/delete so the owner can't reassign userId (P1-3).
    match /conversations/{conversationId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();

      // Messages within conversations — scoped to conversation owner
      match /messages/{messageId} {
        allow read, write: if signedIn() &&
                             request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId;
      }

      // MCQ responses within conversations — scoped to conversation owner
      match /mcqResponses/{responseId} {
        allow read, write: if signedIn() &&
                             request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId;
      }
    }

    // Flashcard decks at root level - owner full access; any authenticated
    // user can read a public deck.
    match /flashcardDecks/{deckId} {
      allow read: if ownsExisting() || (signedIn() && resource.data.isPublic == true);
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // Solver history at root level - accessible by owner
    match /solverHistory/{historyId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // Schoology tokens at root level - accessible by owner
    match /schoologyTokens/{tokenId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // User progress at root level - accessible by owner
    match /userProgress/{progressId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // Practice tests at root level - accessible by owner
    match /practiceTests/{testId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // Test progress at root level - accessible by owner
    // The in-progress doc has a DERIVED id ({uid}_inprogress) and is fetched by
    // id to offer a resume. `ownsExisting()` alone fails for a doc that does
    // not exist yet, because `resource.data` is null — the identical trap that
    // made every new user's first userAchievements read permission-denied.
    // Here it meant a permission error on every Practice Tests load for anyone
    // without an unfinished test, i.e. almost everyone.
    // The id branch is checked first and `||` short-circuits, so the null
    // resource is never touched on that path.
    match /testProgress/{progressId} {
      function ownsById() {
        return signedIn() && progressId == request.auth.uid + '_inprogress';
      }
      allow read: if ownsById() || ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsIncoming() && (ownsById() || ownsExisting());
      allow delete: if ownsById() || ownsExisting();
    }

    // Study sessions at root level - accessible by owner
    match /studySessions/{sessionId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // Diagnostic results at root level - accessible by owner
    match /diagnosticResults/{resultId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();
    }

    // User achievements at root level - accessible by owner.
    // The doc id IS the uid here (achievementsService reads
    // doc(db,'userAchievements',userId)), so ownership is checked against the
    // id rather than resource.data.userId. That matters because resource.data
    // is null for a doc that doesn't exist yet, which made a NEW user's very
    // first read fail with permission-denied — and that error aborted the whole
    // Progress page load, rendering every stat as 0.
    // Two access patterns hit this collection, and the rule must allow both:
    //   1. getDoc(userAchievements/{uid})            -> id branch (works when
    //      the doc does not exist yet, which resource.data cannot)
    //   2. query(where userId == uid, orderBy ...)   -> ownsExisting branch
    // `||` short-circuits, so pattern 1 never touches the null resource.
    match /userAchievements/{achievementId} {
      allow read: if signedIn() && (request.auth.uid == achievementId || ownsExisting());
      allow create: if ownsIncoming();
      allow update: if ownsIncoming();
      allow delete: if signedIn() && (request.auth.uid == achievementId || ownsExisting());
    }

    // Public read-only data (for future use - e.g., shared study resources)
    match /publicData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Reviews - any authenticated user can create; admins can read/delete
    match /reviews/{reviewId} {
      allow create: if ownsIncoming();
      allow read, delete: if isAdmin();
    }

    // Admin collection - only admins can read, no one can write via client
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // ---- Classes / clubs (join links) ----------------------------------
    // This is the ONLY collection where users read data belonging to other
    // users, so the boundaries are deliberately tight.
    //
    // The document id IS the join code, which is why `get` is open to any
    // signed-in caller: holding the id is what proves you were given the link.
    // `list` is denied for exactly the same reason — otherwise anyone could
    // enumerate every class name in the app instead of needing a link.
    match /classes/{classId} {
      // A class may have several owners (co-teachers). ownerIds is the
      // authority; ownerId is kept only as "who created it" for display.
      function isOwner() {
        return signedIn() && request.auth.uid in resource.data.ownerIds;
      }
      function isMember() {
        return signedIn() &&
          exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
      }
      // A member's ONLY legitimate write is bumping the roster counter when
      // they join or leave. Without this clamp, "members may update" meant any
      // student could rename the class or rewrite `subjects` — silently
      // changing what counts on the leaderboard for everyone.
      function memberCountOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']);
      }

      allow get: if signedIn();
      // Owners may query their own classes; nobody may list the collection.
      allow list: if isOwner();
      // A class is always created with exactly its creator as sole owner;
      // co-owners are promoted afterwards, by an existing owner.
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.ownerIds
                    && request.resource.data.ownerIds.size() == 1;
      allow update: if isOwner()
                    || (isMember() && memberCountOnly());
      allow delete: if isOwner();

      match /members/{memberId} {
        // The roster is the leaderboard, so members see each other. Only
        // members — a link-holder who hasn't joined sees the class, not the kids.
        allow read: if signedIn() && (
          request.auth.uid == memberId ||
          exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid))
        );
        // You may only ever write your OWN row. This is what stops a student
        // editing a classmate's score, and stops userId being spoofed.
        allow create, update: if signedIn()
                              && request.auth.uid == memberId
                              && request.resource.data.userId == request.auth.uid;
        // Students can leave; any owner can remove anyone.
        allow delete: if signedIn() && (
          request.auth.uid == memberId ||
          request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.ownerIds
        );
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
