{
  "name": "apex-ai-router",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  "account_id": "db38dfb9f1711b9c55f11ba61a8649c5",
  // Custom domain in the apex-scholar.com zone (auto DNS + SSL). Separate
  // subdomain, so it never touches the Netlify-hosted apex / www.
  "routes": [
    { "pattern": "ai.apex-scholar.com", "custom_domain": true }
  ],
  // One global Durable Object holds the per-student counts. SQLite-backed is
  // the only kind the Workers Free plan allows.
  "durable_objects": {
    "bindings": [{ "name": "GOVERNOR", "class_name": "Governor" }]
  },
  "migrations": [
    { "tag": "v1-governor", "new_sqlite_classes": ["Governor"] }
  ],
  // KV id is filled by `wrangler kv namespace create CACHE` (or the Cloudflare
  // connector). Vars set here; the 11 GEMINI_API_KEY* are secrets (see README).
  "kv_namespaces": [
    { "binding": "CACHE", "id": "45315ec082eb42409ba4555207490337" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://apex-scholar.com,https://www.apex-scholar.com,http://localhost:3000",
    // Audience/issuer for Firebase ID-token verification. Public (it ships in
    // the client bundle), and it lives here rather than in a secret so it can
    // never drift out of sync with the code that reads it: if this is wrong or
    // missing, every signed-in student silently drops to the guest tier and
    // practice tests start returning 403.
    "FIREBASE_PROJECT_ID": "ai-study-helper-f2f24",
    // Load-adaptive limits, read by the Governor (src/index.js). DAILY_CAPACITY
    // is the good-answer pool for ALL keys together per Pacific day; raise it
    // if keys are added or billing is turned on. A student's hourly share
    // floats between HOURLY_MIN (site busy) and HOURLY_MAX (site quiet).
    "DAILY_CAPACITY": "12000",
    "RPM_CAPACITY": "400",
    "HOURLY_MAX": "60",
    "HOURLY_MIN": "6",
    "GUEST_HOURLY_MAX": "20",
    "GUEST_HOURLY_MIN": "3",
    "BURST_PER_MINUTE": "12",
    "GROUP_HOURLY_MAX": "400"
  }
}
